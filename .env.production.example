# ─── Production environment template ────────────────────────────────────────
# Copy to .env on the server: cp .env.production.example .env
# Fill in ALL values — no defaults here for security-sensitive fields.

# ── Domain ───────────────────────────────────────────────────────────────────
DOMAIN=inbetwin.ru
FRONTEND_URL=https://inbetwin.ru

# ── Docker images (GitLab Container Registry) ────────────────────────────────
# Format: registry.gitlab.com/<namespace>/<project>
IMAGE_PREFIX=registry.gitlab.com/khdinova/inbetwinner
IMAGE_TAG=latest

# ── Auth DB ───────────────────────────────────────────────────────────────────
DB_USER=auth_user
DB_PASSWORD=CHANGE_ME_strong_password_1
DB_NAME=auth_db

# ── Social DB ─────────────────────────────────────────────────────────────────
SOCIAL_DB_USER=social_user
SOCIAL_DB_PASSWORD=CHANGE_ME_strong_password_2
SOCIAL_DB_NAME=social_db

# ── RAG DB ────────────────────────────────────────────────────────────────────
RAG_DB_USER=rag_user
RAG_DB_PASSWORD=CHANGE_ME_strong_password_3
RAG_DB_NAME=rag_db

# ── LLM DB ────────────────────────────────────────────────────────────────────
LLM_DB_USER=llm_user
LLM_DB_PASSWORD=CHANGE_ME_strong_password_4
LLM_DB_NAME=llm_db

# ── Agent DB ──────────────────────────────────────────────────────────────────
AGENT_DB_USER=agent_user
AGENT_DB_PASSWORD=CHANGE_ME_strong_password_5
AGENT_DB_NAME=agent_db

# ── Leads DB ──────────────────────────────────────────────────────────────────
LEADS_DB_USER=leads_user
LEADS_DB_PASSWORD=CHANGE_ME_strong_password_6
LEADS_DB_NAME=leads_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=inbetwin
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_minio_access
MINIO_SECRET_KEY=CHANGE_ME_minio_secret
MINIO_BUCKET=inbetwin-rag

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_jwt_secret_min_64_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Telegram MTProto ──────────────────────────────────────────────────────────
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://inbetwin.ru/api/v1/social/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_for_session_encryption

# ── VK ────────────────────────────────────────────────────────────────────────
VK_APP_ID_WEB=
VK_APP_SECRET_WEB=
VK_REDIRECT_URI_WEB=https://inbetwin.ru/api/v1/social/vk/oauth/user/callback
VK_REDIRECT_URI_GROUP=https://inbetwin.ru/api/v1/social/vk/oauth/callback
VK_APP_ID_ANDROID=54511649
VK_APP_SECRET_ANDROID=
VK_REDIRECT_URI_ANDROID=vk54511649://vk.ru/blank.html
VK_APP_ID_IOS=54511650
VK_APP_SECRET_IOS=
VK_REDIRECT_URI_IOS=vk54511650://vk.ru/blank.html
VK_ALLOW_USER_TOKEN_IMPORT=true

# ── Google ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://inbetwin.ru/api/v1/auth/oauth/google/callback
GOOGLE_REDIRECT_URI=https://inbetwin.ru/api/v1/rag/google/callback
GOOGLE_REDIRECT_URL_CALENDAR=https://inbetwin.ru/api/v1/llm/google/callback

# ── amoCRM ────────────────────────────────────────────────────────────────────
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URL=https://inbetwin.ru/api/v1/llm/amocrm/callback

# ── Yandex OAuth ──────────────────────────────────────────────────────────────
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URL=https://inbetwin.ru/api/v1/auth/oauth/yandex/callback

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=inbetwin-crm
# Place firebase-adminsdk.json in ./secrets/ on the server

# ── AI / LLM ─────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
# If using Groq: LLM_PROVIDER=groq, LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_TOOL_ITERATIONS=5
HISTORY_SIZE=20
HOT_LEAD_THRESHOLD=80

# ── Cohere Embeddings ─────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=cohere
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-v4.0
OPENAI_EMBEDDING_DIMS=1536

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_HOST=

# ── Pinterest / Facebook ──────────────────────────────────────────────────────
PINTEREST_ACCESS_TOKEN=
FACEBOOK_PAGE_TOKEN=

# ── RAG settings ─────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_MIN_SCORE=0.70
